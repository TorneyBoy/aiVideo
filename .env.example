# Copy to .env. Keep real credentials in .env only.
# Existing process environment variables take precedence. Restart after editing.

# Volcengine Ark video: copy the API key and accessible model/endpoint ID
# from the Ark console. Cloud-account AK/SK are not used here.
ARK_API_KEY=
ARK_VIDEO_MODEL=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# For an endpoint ID, explicitly select its actual model family.
ARK_VIDEO_FAMILY=
ARK_VIDEO_RESOLUTION=720p

# Full Hypit production: image editing and multimodal director model IDs in the SAME Ark project.
# Examples only; enable the selected models before starting a formal production.
# ARK_IMAGE_MODEL=doubao-seedream-5-0-pro-260628
# ARK_DIRECTOR_MODEL=doubao-seed-2-1-pro-260915
ARK_IMAGE_MODEL=
ARK_DIRECTOR_MODEL=

# Server-local storage is the default. Use a dedicated HTTPS hostname with the reverse proxy below.
MATERIAL_STORAGE=local
MATERIAL_DIRECTORY=runs/materials
MATERIAL_PUBLIC_BASE_URL=
# Generate a random key of at least 32 bytes. Never publish it in a browser or source control.
MATERIAL_SIGNING_KEY=
MATERIAL_URL_TTL_SECONDS=21600
MATERIAL_RETENTION_SECONDS=86400
MATERIAL_CLEANUP_INTERVAL_SECONDS=900
MATERIAL_MAX_BYTES=2147483648
MATERIAL_MIN_FREE_BYTES=2147483648
# Public workbench requires a username and a password of at least 16 characters.
APP_PUBLIC_URL=
APP_AUTH_USER=
APP_AUTH_PASSWORD=

# Optional compatibility backend: set MATERIAL_STORAGE=tos to use these fields.
# Use a private bucket and credentials limited to GetObject/PutObject on TOS_PREFIX.
TOS_BUCKET=
TOS_REGION=cn-beijing
# Empty: derived from TOS_REGION, e.g. tos-cn-beijing.volces.com.
TOS_ENDPOINT=
TOS_ACCESS_KEY_ID=
TOS_SECRET_ACCESS_KEY=
TOS_SECURITY_TOKEN=
TOS_PREFIX=aivideo
TOS_URL_TTL_SECONDS=21600

# Doubao (volcengine and doobao are accepted aliases).
VOICE_PROVIDER=doubao

# Doubao Speech NEW console: a speech API key, separate from the Ark key.
VOLC_SPEECH_API_KEY=
VOLC_SPEECH_RESOURCE_ID=seed-icl-2.0
VOLC_ASR_RESOURCE_ID=volc.seedasr.auc
# Optional: existing cloned voice ID. Otherwise a voice must be registered first.
VOLC_SPEECH_SPEAKER_ID=
# Optional UNTRAINED prepaid slot; leave empty to create a deterministic custom voice.
VOLC_SPEECH_CLONE_SPEAKER_ID=
VOLC_SPEECH_LANGUAGE=cn
VOLC_SPEECH_RATE=0

# Optional independent voice-conversion service. It uses the saved original
# recording, not Doubao's closed voice model; VC quality/pitch must be verified.
VOICE_CONVERSION_URL=
VOICE_CONVERSION_TOKEN=

# Doubao Speech OLD console only: use these instead of VOLC_SPEECH_API_KEY.
VOLC_SPEECH_APP_ID=
VOLC_SPEECH_ACCESS_TOKEN=

# Optional service base for a private gateway; default is openspeech.bytedance.com.
# VOLC_SPEECH_BASE_URL=https://openspeech.bytedance.com

# Optional Chromium browser for Hypit's native local composition renderer.
# Existing Chrome / Microsoft Edge is detected automatically; no browser download.
HYPIT_CHROME_PATH=
